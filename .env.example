# joycode-proxy environment — copy to `.env` and fill in YOUR OWN credentials.
#
# Where to find them (VS Code-family storage of the JoyCode IDE):
#   Windows : %APPDATA%\JoyCode\User\globalStorage\state.vscdb
#   macOS   : ~/Library/Application Support/JoyCode/User/globalStorage/state.vscdb
#   Linux   : ~/.config/JoyCode/User/globalStorage/state.vscdb
#
# It is a SQLite DB; read the row with key "JoyCoder.IDE" from table `ItemTable`.
# Its JSON contains jdhLoginInfo.{ptKey,colorBaseUrl,masterBaseUrl,tenant,loginType}.
#
# >>> NEVER commit the resulting .env — it holds your account ticket. <<<

JOYCODE_PT_KEY=
JOYCODE_TENANT=
JOYCODE_COLOR_BASE_URL=https://api-ai.jd.com
JOYCODE_MASTER_BASE_URL=http://joycode-api-saas.jd.com
JOYCODE_LOGIN_TYPE=PIN_JD_CLOUD
JOYCODE_PROXY_PORT=8318
JOYCODE_PROXY_HOST=127.0.0.1
JOYCODE_PROXY_MODEL=JoyAI-Code-1.6
JOYCODE_PROXY_API_KEY=
